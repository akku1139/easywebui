# Cloudflare Pages Configuration Template
# This file is used as a template for GitHub Actions
# Placeholders will be replaced with actual values from GitHub Secrets

name = "ai-chat"
compatibility_date = "2024-12-01"
pages_build_output_dir = "dist"

# D1 Database binding
# database_id will be replaced by GitHub Actions
[[d1_databases]]
binding = "AI_CHAT_DB"
database_name = "ai-chat-db"
database_id = "{{D1_DATABASE_ID}}"

# Model names, provider URLs and keys are configured in Settings (D1).

# Note: The following secrets should be set in GitHub repository settings:
# - BASIC_AUTH_USER
# - BASIC_AUTH_PASS
# - CLOUDFLARE_API_TOKEN
# - CLOUDFLARE_ACCOUNT_ID
# - D1_DATABASE_ID

# Development settings
[dev]
port = 8788
